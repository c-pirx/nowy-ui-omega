node_modules/
dist/
.tmp/

# LocalWP tworzy te katalogi w korzeniu repozytorium.
# Rdzeń WordPressa, baza, konfiguracja, logi, wtyczki i media są lokalne.
/conf/
/logs/
/app/*
!/app/public/
/app/public/*
!/app/public/wp-content/
/app/public/wp-content/*

# Wersjonujemy wyłącznie własny motyw i wtyczkę projektu.
!/app/public/wp-content/themes/
/app/public/wp-content/themes/*
!/app/public/wp-content/themes/omega/
!/app/public/wp-content/themes/omega/**

!/app/public/wp-content/plugins/
/app/public/wp-content/plugins/*
!/app/public/wp-content/plugins/omega-core/
!/app/public/wp-content/plugins/omega-core/**

# Lokalna konfiguracja narzędzi Claude Code.
.claude/
